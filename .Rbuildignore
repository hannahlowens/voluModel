# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# Git & GitHub
^\.git$
^\.gitignore$
^\.github$

# Documentation & pkgdown
^docs$
^pkgdown$
^README\.Rmd$
^README_files$
^readme\.md$
^LICENSE\.md$
^CODE_OF_CONDUCT\.md$
^CONTRIBUTING\.md$
^cran-comments\.md$
^CRAN-RELEASE$
^CRAN-SUBMISSION$

# Config files
^codecov\.yml$
^.*\.yml$

# Data & analysis artifacts
^data-raw$
^man/figures/SoMePreview$
^man/figures/vmHex\.ai$

# Test artifacts
^tests/testthat/Rplots\.pdf$

# Dependency managers & caches
^renv$
^renv\.lock$
^packrat$
^_targets$
^targets\.json$
^\.pytest_cache$
^\.ruff_cache$

# IDE/editor artifacts
^\.DS_Store$
^\.vscode$
^\.idea$
^\.dropbox.*$

# Misc
^~$
^\.positai$
^\.claude$
